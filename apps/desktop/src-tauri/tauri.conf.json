{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clipwise",
  "version": "0.1.0",
  "identifier": "com.clipwise.app",
  "build": {
    "beforeDevCommand": "node ../../scripts/desktop-dev.mjs",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Clipwise",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:37771; connect-src 'self' http://127.0.0.1:37771; img-src 'self' data: blob: http://127.0.0.1:37771; media-src 'self' data: blob: http://127.0.0.1:37771; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
